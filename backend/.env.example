# Flask App Configuration
FLASK_PORT=5000
FLASK_DEBUG=True

# Supabase Credentials
# Get these from your Supabase Dashboard under Settings > API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-service-role-key-or-anon-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-for-jwt-verification

# Gmail SMTP Configuration
# Get your App Password from your Google Account > Security > App Passwords
GMAIL_EMAIL=your-email@gmail.com
GMAIL_APP_PASSWORD=your-gmail-app-password
